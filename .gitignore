# Python
# ---------------------------------------------------------
venv/
.venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# ---------------------------------------------------------
# Test & type-check caches
# ---------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

